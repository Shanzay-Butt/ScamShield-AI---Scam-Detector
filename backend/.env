# ── Dev API key (bypasses Redis auth lookup — remove in production) ───────────
DEV_API_KEY=dev-key

# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# ── CORS (frontend dev server) ────────────────────────────────────────────────
API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# ── Redis (optional in dev — app degrades gracefully if Redis is offline) ─────
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=scam:

# ── ML / TorchServe (optional — pipeline runs in rule-only mode without it) ───
ML_GRPC_HOST=localhost
ML_GRPC_PORT=7070
ML_MODEL_VERSION=scam-deberta-v1.0.0
ML_TIMEOUT_MS=1500

# ── URL Checker (optional — leave empty to skip external URL checks) ──────────
URL_CHECK_GSB_API_KEY=
URL_CHECK_PHISHTANK_API_KEY=
URL_CHECK_TIMEOUT_MS=800

# ── LLM (optional — falls back to template explanations when empty) ───────────
LLM_OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=400

# ── Score weights ─────────────────────────────────────────────────────────────
SCORE_WEIGHT_ML=0.55
SCORE_WEIGHT_RULE=0.25
SCORE_WEIGHT_URL=0.20
