# ── API ───────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=scam:

# ── ML / TorchServe ───────────────────────────────────────────────────────────
ML_GRPC_HOST=localhost
ML_GRPC_PORT=7070
ML_MODEL_VERSION=scam-deberta-v1.0.0
ML_TIMEOUT_MS=1500

# ── URL Checker ───────────────────────────────────────────────────────────────
GSB_API_KEY=your-google-safe-browsing-key
PHISHTANK_API_KEY=your-phishtank-key
URL_CHECK_TIMEOUT_MS=800

# ── LLM ───────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-key
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_MS=400

# ── Score weights ─────────────────────────────────────────────────────────────
SCORE_WEIGHT_ML=0.55
SCORE_WEIGHT_RULE=0.25
SCORE_WEIGHT_URL=0.20

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_JWKS_URL=https://your-auth-provider/.well-known/jwks.json
JWT_ISSUER=https://your-auth-provider/
JWT_AUDIENCE=scam-detector
